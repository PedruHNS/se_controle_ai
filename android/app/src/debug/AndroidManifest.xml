<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- A liberação de HTTP não está aqui: vive em
         `main/res/xml/network_security_config.xml`, restrita aos hosts do backend
         local e valendo também em release. Um `usesCleartextTraffic="true"` neste
         arquivo liberaria HTTP para qualquer endereço, e só em debug — ou seja,
         mais permissivo e ainda assim insuficiente para um APK instalado. -->
</manifest>
