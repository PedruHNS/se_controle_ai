{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
    
        {
            "name": "se_controle_ai",
            "request": "launch",
            "type": "dart"
        },
        {
            // Backend pelo cabo USB: exige `adb reverse tcp:3333 tcp:3333`
            // uma vez por conexão do aparelho. Não depende de Wi-Fi nem do IP
            // da máquina, que é DHCP e muda sozinho.
            "name": "se_controle_ai (USB / adb reverse)",
            "request": "launch",
            "type": "dart",
            "toolArgs": [
                "--dart-define=API_BASE_URL=http://localhost:3333"
            ]
        },
        {
            "name": "se_controle_ai (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "se_controle_ai (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}